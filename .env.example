# Choose one provider key. If multiple are set, XAI takes precedence over
# Gemini, which takes precedence over OpenAI.
XAI_API_KEY=
XAI_MODEL=grok-3

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Used only when XAI_API_KEY and GEMINI_API_KEY are empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
